# Build image for the Fedora 44 (native) Apostrophe AppImage.
#
# Everything is installed inside this image.  The host filesystem is never
# modified.  glibc is intentionally not bundled into the final AppImage.
ARG BASE_IMAGE=quay.io/fedora/fedora:44
FROM ${BASE_IMAGE}

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# The metalink mirror list selects hosts that are unreachable from this
# environment.  Use Fedora's canonical download host directly.
RUN set -eux; \
    sed -i \
      -e 's|^metalink=.*|# metalink disabled for reproducible container builds|' \
      -e 's|^#baseurl=http://download.example/pub/fedora/linux/releases/|baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/|' \
      /etc/yum.repos.d/fedora.repo; \
    sed -i \
      -e 's|^metalink=.*|# metalink disabled for reproducible container builds|' \
      -e 's|^#baseurl=http://download.example/pub/fedora/linux/updates/|baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/|' \
      /etc/yum.repos.d/fedora-updates.repo; \
    sed -i 's|^enabled=1|enabled=0|' /etc/yum.repos.d/fedora-cisco-openh264.repo

RUN dnf -y --setopt=install_weak_deps=False --setopt=retries=10 --setopt=timeout=60 install \
      meson ninja-build gcc gcc-c++ make \
      pkgconf-pkg-config git \
      python3 python3-devel python3-pip \
      glib2-devel gobject-introspection-devel \
      gtk4-devel libadwaita-devel gtksourceview5-devel \
      libspelling-devel webkitgtk6.0-devel \
      python3-gobject python3-cairo python3-regex python3-chardet \
      python3-pypandoc \
      appstream desktop-file-utils gettext \
      libxml2-devel libxml2 \
      gdk-pixbuf2 shared-mime-info fontconfig \
      hicolor-icon-theme adwaita-icon-theme \
      patchelf file wget curl tar xz which hostname \
      binutils findutils \
      glibc-langpack-en \
      dbus-daemon bubblewrap \
 && dnf clean all

# Networking, settings schemas and spell-check providers are runtime pieces
# that weak dependencies would otherwise leave out.
RUN dnf -y --setopt=install_weak_deps=False --setopt=retries=10 --setopt=timeout=60 install \
      glib-networking ca-certificates gsettings-desktop-schemas libproxy \
      enchant2 \
 && dnf clean all

# Optional components.  A missing optional package must not break the build;
# the inner build reports what was actually available.  Pandoc, Typst and
# Xvfb are deliberately not RPM-installed here: pandoc/typst are fetched as
# upstream static binaries when absent, and Xvfb is only for a separate test
# image.
RUN for p in \
      hunspell-en hunspell-en-US hunspell-en-GB \
      enchant2-hunspell \
      mozilla-fira-sans-fonts mozilla-fira-mono-fonts \
      python3-levenshtein \
    ; do \
      dnf -y --setopt=install_weak_deps=False --setopt=retries=10 --setopt=timeout=60 install "$p" || echo "optional package unavailable: $p"; \
    done \
 && dnf clean all

# SVG rasterizer used to produce a PNG .DirIcon for appimagetool.
RUN dnf -y --setopt=install_weak_deps=False --setopt=retries=10 --setopt=timeout=60 install \
      librsvg2-tools \
 && dnf clean all

WORKDIR /work
